# =============================================================================
# AccessBank AI Support Agent — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- OpenAI ---
# Hackathon-provided key. Rotate after the hackathon.
OPENAI_API_KEY=sk-proj-REPLACE_ME
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Telegram ---
# From @BotFather: /newbot -> token
TELEGRAM_BOT_TOKEN=REPLACE_ME

# --- Gmail (bot sender) ---
# The Gmail account that owns the OAuth credentials and sends escalation emails.
# Replies from dept mailboxes land in this inbox; the poller reads them here.
GMAIL_SENDER=accessbank.bot@gmail.com

# --- Department mailboxes (real Gmail addresses you control) ---
DEPT_DIGITAL_EMAIL=accessbank.digital.dep@gmail.com
DEPT_CARDS_EMAIL=accessbank.cards.dep@gmail.com
DEPT_TRANSFERS_EMAIL=accessbank.transfers.dep@gmail.com
DEPT_LOANS_EMAIL=accessbank.loans.dep@gmail.com
DEPT_BRANCH_EMAIL=accessbank.branch.dep@gmail.com

# --- Paths ---
GMAIL_CREDENTIALS_PATH=credentials/credentials.json
GMAIL_TOKEN_PATH=credentials/token.json
CASES_DB_PATH=data/cases.db
CHROMA_PATH=data/chroma
AUDIT_LOG_PATH=data/audit.log
KNOWLEDGE_DIR=knowledge

# --- Email provider selection ---
# Choose which API the bot uses to send escalation emails: "gmail" or "outlook".
# Default = gmail. Set to "outlook" to send via Microsoft Graph instead.
EMAIL_PROVIDER=gmail

# --- Microsoft Graph (optional, only used when EMAIL_PROVIDER=outlook) ---
# Azure AD App Registration values. See README "Microsoft Graph OAuth" section.
MS_GRAPH_CLIENT_ID=
MS_GRAPH_TENANT_ID=common
MS_GRAPH_SENDER=accessbank.bot@outlook.com
MS_GRAPH_TOKEN_PATH=credentials/ms_token.json

# --- Behavior tuning ---
INBOX_POLL_INTERVAL_SECONDS=30
RATE_LIMIT_MAX_MSGS=20
RATE_LIMIT_WINDOW_SECONDS=300
KB_TOP_K=3
